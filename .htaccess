ErrorDocument 404 /804.html
ErrorDocument 403 /804.html
RedirectMatch 404 /\.git
Options -Indexes
AddDefaultCharset UTF-8

RewriteEngine On

RewriteCond %{SERVER_PROTOCOL} ^HTTP/1\.$
RewriteCond %{HTTP_REFERER} !(zoyayosyny\.ru|^$)
RewriteRule ^kzn\.xml$ - [R=404,L]
RewriteRule ^sync.sh$ - [F,L]

# Примечание: Применен алгоритм защиты для robots.txt и htaccess через HTTP-фильтрацию.
